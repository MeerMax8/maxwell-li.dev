---
import Base from "../layouts/Base.astro";
import { projects, alts } from "../data/projects";

const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
const play = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a.5.5 0 0 0 .77.42l10.2-6.5a.5.5 0 0 0 0-.84L8.77 5.08A.5.5 0 0 0 8 5.5z"/></svg>`;
const models = Object.fromEntries(projects.map((p) => [p.slug, p.model]));
const pad = (n: number) => String(n).padStart(2, "0");
---

<Base title="Projects: Maxwell Li" description="Titan, an autonomous quadcopter; Phaethon, a ground-effect vehicle; and two VEX V5 competition robots, with CAD, photos and footage." page="projects">
  <header class="pj-head" id="pj-head">
    <canvas class="well" id="pj-well" aria-hidden="true"></canvas>
    <span class="reg" style="top:84px;left:var(--margin)"></span>
    <span class="reg" style="top:84px;right:var(--margin)"></span>
    <h1>Projects</h1>
    <p class="lede">Four machines, newest first. Each one scrolls through its CAD, then the build photos and footage.</p>
    <ol class="index">
      {projects.map((p, i) => (
        <li>
          <a href={`#${p.slug}`}>
            <span class="mono n">{pad(i + 1)}</span>
            <span class="t">{p.name}</span>
            <span class="mono d">{p.dates}</span>
            <Fragment set:html={arrow} />
          </a>
        </li>
      ))}
    </ol>
  </header>

  <div class="pstage" id="pstage" aria-hidden="true">
    <span class="pword" id="pword"></span>
    <canvas id="pgl"></canvas>
    <img class="pstill" id="pstill" src={projects[0].still} alt="" loading="lazy" />
  </div>

  {projects.map((p, i) => (
    <>
      <section class="chapter" id={p.slug} data-key={p.slug} data-short={p.short} data-still={p.still} aria-labelledby={`${p.slug}-h`}>
        <div class="steps">
          <div class="step first">
            <h2 id={`${p.slug}-h`}>{p.name}</h2>
            <p class="mono meta">{p.role}{p.solo ? ", solo build" : ""}<br />{p.dates}</p>
            <ul class="tags" aria-label="Tools">
              {p.stack.map((t) => <li class="mono">{t}</li>)}
            </ul>
          </div>
          {p.summary.map((s) => (
            <div class={`step ${s.label === "Results" ? "result" : ""}`}>
              <h3 class="label">{s.label}</h3>
              <p>{s.text}</p>
              {s.label === "Results" && p.logbook && (
                <a class="link-arrow" href={p.logbook} target="_blank" rel="noopener noreferrer">Engineering logbook (PDF) <Fragment set:html={arrow} /></a>
              )}
            </div>
          ))}
        </div>
      </section>

      <section class={`media ${p.youtube ? "wide" : "tall"}`} aria-label={`${p.short} photos and video`}>
        <div class="feature">
          {p.youtube ? (
            <button class="yt" data-yt={p.youtube.id} aria-label={`Play ${p.youtube.label}`}>
              <img src={`https://i.ytimg.com/vi/${p.youtube.id}/maxresdefault.jpg`} alt="" loading="lazy" onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" />
              <span class="play"><Fragment set:html={play} /></span>
              <span class="mono cap">{p.youtube.label}</span>
            </button>
          ) : p.feature && (
            <figure>
              <video controls playsinline preload="none" poster={p.feature.poster}>
                <source src={p.feature.video} type="video/mp4" />
              </video>
              <figcaption class="mono cap">{p.feature.label}</figcaption>
            </figure>
          )}
        </div>
        <ul class="strip">
          {p.strip.map((src) => (
            <li>
              <button class="thumb" data-full={`${src}-1600.webp`} aria-label={`Enlarge: ${alts[src] ?? p.short + " build photo"}`}>
                <img src={`${src}-640.webp`} alt={alts[src] ?? `${p.short} build photo`} loading="lazy" decoding="async" />
              </button>
            </li>
          ))}
        </ul>
        <details class="archive">
          <summary class="mono">Full build archive <span>{p.archive.photos.length} {p.archive.photos.length === 1 ? "photo" : "photos"}, {p.archive.videos.length} {p.archive.videos.length === 1 ? "video" : "videos"}</span></summary>
          <div class="archive-grid">
            {p.archive.photos.map((src) => (
              <button class="thumb" data-full={`${src}-1600.webp`} aria-label={`Enlarge ${p.short} photo`}>
                <img src={`${src}-640.webp`} alt={`${p.short} build photo`} loading="lazy" decoding="async" />
              </button>
            ))}
            {p.archive.videos.map((v) => (
              <video controls playsinline preload="none" poster={v.poster}><source src={v.src} type="video/mp4" /></video>
            ))}
          </div>
        </details>
      </section>
    </>
  ))}

  <dialog class="lightbox" id="lightbox" aria-label="Photo">
    <img id="lightbox-img" src={`${projects[0].strip[0]}-1600.webp`} alt="Build photo, enlarged" loading="lazy" />
    <button class="close" id="lightbox-close" aria-label="Close photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  </dialog>

  <script type="application/json" id="models-json" set:html={JSON.stringify(models)} />
</Base>

<style>
  .pj-head { position: relative; overflow: hidden; padding: calc(var(--nav-h) + clamp(64px, 12vh, 140px)) var(--margin) clamp(64px, 10vh, 120px); background: var(--navy-900); }
  .pj-head > :not(.well) { position: relative; z-index: 1; }
  .pj-head .well { position: absolute; inset: 0; z-index: 0; opacity: 0.8; }
  .pj-head h1 { font-size: clamp(4rem, 14vw, 13rem); font-stretch: 120%; font-weight: 800; letter-spacing: -0.04em; line-height: 0.88; }
  .lede { margin-top: 24px; max-width: 46ch; font-size: clamp(1.05rem, 1.5vw, 1.3rem); color: var(--muted); }
  .index { list-style: none; margin: clamp(48px, 8vh, 88px) 0 0; padding: 0; border-top: 1px solid var(--line); max-width: 1320px; }
  .index a { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto 24px; gap: 16px; align-items: center; min-height: 64px; padding: 14px 4px; border-bottom: 1px solid var(--line); text-decoration: none; background: rgba(11, 29, 46, 0.6); transition: background-color 160ms var(--ease-out); }
  .index a .t, .index a svg { transition: transform 300ms var(--ease); }
  .index a:hover { background: rgba(16, 40, 59, 0.92); }
  .index a:hover .t { transform: translateX(8px); }
  .index a:hover svg { transform: translateX(4px); }
  .index .n { color: var(--copper-hi); }
  .index .t { font-size: clamp(1.1rem, 2vw, 1.6rem); font-weight: 600; font-stretch: 105%; letter-spacing: -0.01em; }
  .index .d { color: var(--muted); }
  .index svg { width: 20px; height: 20px; color: var(--copper-hi); }
  @media (max-width: 640px) { .index a { grid-template-columns: 40px minmax(0, 1fr) 20px; } .index .d { display: none; } }

  /* One fixed stage for the whole page; chapters drive it */
  .pstage { position: fixed; top: 0; right: 0; width: 58vw; height: 100svh; z-index: 1; pointer-events: none; opacity: 0; transition: opacity 500ms var(--ease-out); }
  .pstage.on { opacity: 1; }
  .pstage canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pword { position: absolute; left: 50%; top: 50%; translate: -50% -50%; font-size: clamp(5rem, 15vw, 16rem); font-weight: 800; font-stretch: 125%; letter-spacing: -0.03em; text-transform: uppercase; white-space: nowrap; color: transparent; -webkit-text-stroke: 1.5px rgba(157, 176, 191, 0.18); }
  .pstill { position: absolute; left: 50%; top: 50%; width: 76%; translate: -50% -50%; display: none; }
  .pstage.use-stills canvas { display: none; }
  .pstage.use-stills .pstill, .pstage.loading .pstill { display: block; }

  .chapter { position: relative; background: var(--navy-900); }
  .chapter::before { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 58vw; background: radial-gradient(ellipse 60% 40% at 50% 78%, rgba(215, 132, 70, 0.14), transparent 70%); pointer-events: none; }
  .steps { position: relative; z-index: 2; width: 42vw; padding: 0 clamp(20px, 3vw, 48px) 0 var(--margin); }
  .step { min-height: 120svh; display: flex; flex-direction: column; justify-content: center; padding: 10svh 0; }
  .step.first { min-height: 130svh; }
  .step h2 { font-size: clamp(2.2rem, 4.4vw, 4.4rem); font-stretch: 112%; letter-spacing: -0.03em; line-height: 0.98; }
  .step .meta { margin-top: 22px; color: var(--muted); line-height: 1.8; text-transform: none; letter-spacing: 0.04em; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 24px 0 0; padding: 0; }
  .tags li { padding: 6px 10px; border: 1px solid var(--line); border-radius: 999px; color: #c8d5de; font-size: 11px; }
  .step .label { color: var(--copper-hi); font-weight: 600; font-stretch: 108%; letter-spacing: -0.01em; font-size: clamp(1.2rem, 1.6vw, 1.45rem); margin-bottom: 12px; }
  .step p:not(.mono) { font-size: clamp(1.05rem, 1.35vw, 1.25rem); line-height: 1.6; color: #dce4ea; max-width: 44ch; }
  .step.result p:not(.mono) { font-size: clamp(1.35rem, 2.1vw, 1.9rem); line-height: 1.35; font-weight: 600; letter-spacing: -0.01em; color: var(--ink); }
  .step .link-arrow { margin-top: 18px; }

  /* Media after each chapter */
  .media { position: relative; z-index: 3; background: var(--navy-950); border-top: 1px solid var(--line); padding: clamp(56px, 9vh, 100px) var(--margin); display: grid; gap: clamp(16px, 2vw, 28px); }
  .media.wide { grid-template-columns: 1fr; }
  .media.tall { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: start; }
  .media.tall .archive { grid-column: 1 / -1; }
  .feature { position: relative; }
  .feature figure { margin: 0; }
  .feature video { width: auto; max-width: 100%; max-height: 78svh; margin-inline: auto; border-radius: 6px; background: var(--navy-950); object-fit: contain; }
  .media.wide .feature { max-width: 1100px; width: 100%; margin-inline: auto; }
  :global(div.yt), .yt { position: relative; display: block; width: 100%; padding: 0; border: 0; border-radius: 6px; overflow: hidden; cursor: pointer; aspect-ratio: 16 / 9; background: #000; }
  .yt img { width: 100%; height: 100%; object-fit: cover; opacity: 0.82; transition: opacity 300ms var(--ease-out), transform 700ms var(--ease); }
  .yt:hover img { opacity: 1; transform: scale(1.015); }
  .yt .play { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 76px; height: 76px; border-radius: 50%; background: var(--copper); color: var(--navy-950); display: grid; place-items: center; transition: transform 160ms var(--ease-out); }
  .yt .play svg { width: 30px; height: 30px; margin-left: 3px; }
  .yt:hover .play { transform: scale(1.06); }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .cap { position: absolute; left: 14px; bottom: 14px; padding: 6px 10px; border-radius: 4px; background: rgba(7, 23, 36, 0.8); color: var(--ink); }
  .feature figure .cap { position: static; display: inline-block; margin-top: 10px; background: none; padding: 0; color: var(--muted); }

  .strip { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .media.wide .strip { grid-template-columns: repeat(5, 1fr); }
  .media.tall .strip { grid-template-columns: repeat(2, 1fr); }
  .media.tall .strip li:first-child { grid-column: 1 / -1; }
  .thumb { display: block; width: 100%; padding: 0; border: 0; border-radius: 6px; overflow: hidden; cursor: zoom-in; background: var(--surface); aspect-ratio: 4 / 3; }
  .media.tall .strip li:first-child .thumb { aspect-ratio: 16 / 9; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease), filter 300ms var(--ease-out); filter: saturate(0.9); }
  .thumb:hover img { transform: scale(1.04); filter: none; }

  .archive { border-top: 1px solid var(--line); padding-top: 8px; }
  .archive summary { display: flex; align-items: center; gap: 14px; min-height: 48px; cursor: pointer; color: var(--ink); list-style: none; }
  .archive summary::-webkit-details-marker { display: none; }
  .archive summary::before { content: ""; width: 10px; height: 10px; border-right: 1.5px solid var(--copper); border-bottom: 1.5px solid var(--copper); transform: rotate(-45deg); transition: transform 200ms var(--ease-out); }
  .archive[open] summary::before { transform: rotate(45deg); }
  .archive summary span { color: var(--muted); text-transform: none; letter-spacing: 0.02em; }
  .archive-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; padding: 14px 0 6px; }
  .archive-grid video { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 6px; background: #000; }

  .lightbox { max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; margin: 0; padding: 4vmin; border: 0; background: rgba(4, 13, 21, 0.94); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: transparent; }
  .lightbox img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 4px; }
  .lightbox .close { position: absolute; top: 16px; right: 16px; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--line); background: var(--navy-900); color: var(--ink); display: grid; place-items: center; cursor: pointer; }
  .lightbox .close svg { width: 22px; height: 22px; }

  @media (max-width: 860px) {
    .pstage { width: 100vw; height: 46svh; background: var(--navy-900); border-bottom: 1px solid var(--line); z-index: 4; }
    .chapter::before { display: none; }
    .steps { width: auto; padding: 46svh var(--margin) 0; }
    .step { min-height: 90svh; padding: 6svh 0; justify-content: flex-start; }
    .step.first { min-height: 90svh; }
    .media.tall { grid-template-columns: 1fr; }
    .media.wide .strip { grid-template-columns: repeat(2, 1fr); }
    .media.wide .strip li:first-child { grid-column: 1 / -1; }
    .pword { font-size: 26vw; }
  }
  /* no JS / reduced motion: chapters show a still beside the text */
  :global(html:not(.js)) .pstage { display: none; }
  :global(html:not(.js)) .steps, :global(.static-chapters) .steps { width: auto; max-width: 760px; padding-top: 0; }
  :global(.static-chapters) .pstage { display: none; }
  :global(.static-chapters) .step { min-height: 0; padding: 32px 0; }
  :global(.static-chapters) .chapter::before { display: none; }
  :global(.static-chapters) .step.first::before { content: ""; display: block; aspect-ratio: 16 / 10; margin-bottom: 24px; background: var(--still) center / contain no-repeat; }
  @media (prefers-reduced-motion: reduce) { .thumb img, .yt img, .index a, .index a .t, .index a svg { transition: none; } }
</style>

<script>
  import { initProjects } from "../scripts/projects";
  initProjects();
</script>
