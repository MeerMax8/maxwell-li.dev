---
import Base from "../layouts/Base.astro";
import { projects, bySlug } from "../data/projects";

// The home story travels through all four machines (co-designed with Codex, rounds 1 and 2).
const beats = [
  { slug: "quadcopter", word: "Design", text: "A custom 50 cm frame, designed in Fusion 360 and 3D printed. It's on its 6th iteration." },
  { slug: "vex-highstakes", word: "Build", text: "Robot subsystems designed in Inventor and machined over a 10-month build season. 14 competition awards." },
  { slug: "overunder", word: "Control", text: "PID speed control, odometry and pure pursuit path tracking in PROS. VEX World Championship Build Award." },
  { slug: "ekranoplan", word: "Test", text: "Draws 45 W at 600 g: 63% less power per kilogram than the quadcopter." },
];

const lines: Record<string, string> = {
  quadcopter: "Follows objects on its own: YOLOv8 on a Raspberry Pi 5, talking to the flight controller over MAVLink.",
  ekranoplan: "An 80 cm foam airframe that glides on water and uses 63% less power per kilogram than the quadcopter.",
  overunder: "VEX World Championship Build Award, top 100 of 40,000+ teams, and two mechanisms recognized as world firsts.",
  "vex-highstakes": "A codebase rewritten from the ground up, vision tracking of game elements, and 14 competition awards.",
};

const hobbies = [
  { title: "Travelling", img: "/media/about/travelling-640.webp", alt: "A city skyline and a lit bridge over a river at night" },
  { title: "Robotics", img: "/media/about/robotics-640.webp", alt: "A crowded VEX competition floor" },
  { title: "Gaming", img: "/media/about/gaming-640.webp", alt: "A gaming setup lit in purple and blue" },
  { title: "Instruments", img: "/media/about/instruments-640.webp", alt: "A grand piano" },
  { title: "Hiking", img: "/media/about/hiking-640.webp", alt: "Maxwell on a rocky summit above a river valley" },
];

const quote = "What defines me are not my experiences, but rather the person I choose to become after walking through them";
const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
const models = Object.fromEntries(projects.map((p) => [p.slug, p.model]));
---

<Base title="Maxwell Li: mechatronics engineering" description="Maxwell Li designs, builds and programs machines: an autonomous quadcopter, a ground-effect vehicle, and VEX robots that won a World Championship Build Award." page="home">
  <section class="story" id="story" aria-label="Four machines">
    <div class="stage">
      <div class="well-wrap" aria-hidden="true"><canvas class="well" id="well"></canvas></div>
      <div class="floor" aria-hidden="true"></div>
      <div class="words" aria-hidden="true">
        {beats.map((b) => <span class="word" data-word={b.word}>{b.word}</span>)}
      </div>
      <canvas class="gl" id="gl" aria-hidden="true"></canvas>
      <div class="stills" aria-hidden="true">
        {beats.map((b) => <img src={bySlug[b.slug].still} alt="" data-still={b.slug} loading="lazy" decoding="async" />)}
      </div>
      <span class="reg" style="top:84px;left:var(--margin)"></span>
      <span class="reg" style="top:84px;right:var(--margin)"></span>
      <span class="reg" style="bottom:28px;left:var(--margin)"></span>
      <span class="reg" style="bottom:28px;right:var(--margin)"></span>

      <div class="intro">
        <h1>Maxwell Li</h1>
        <p class="line">Mechatronics engineering at the University of Waterloo. Controls and embedded systems.</p>
        <div class="scale-bar" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
        <div class="actions">
          <a class="btn primary" href="/projects">View projects</a>
          <a class="btn" href="#contact">Contact</a>
        </div>
      </div>

      <ol class="beats">
        {beats.map((b, i) => (
          <li class="beat" data-beat={i} style={`--still:url(${bySlug[b.slug].still})`}>
            <h2>{bySlug[b.slug].name}</h2>
            <p class="text">{b.text}</p>
            <a class="link-arrow" href={`/projects#${b.slug}`}>See the build <Fragment set:html={arrow} /></a>
          </li>
        ))}
      </ol>

      <p class="mono chapter-marker" aria-hidden="true">01 / 04</p>

      <div class="stack" aria-hidden="true">
        {beats.map((b) => <span>{b.word}</span>)}
      </div>
      <p class="handoff">Designed, built, programmed<br />and tested.</p>
    </div>
  </section>

  <section class="machines" id="machines" aria-labelledby="machines-h">
    <div class="machines-head">
      <h2 id="machines-h">The builds</h2>
      <p>A VEX World Championship Build Award and a top-100 finish out of more than 40,000 teams in Over Under, 14 competition awards in High Stakes, and two aircraft built solo.</p>
    </div>
    <div class="rail" id="rail" role="group" aria-roledescription="carousel" aria-label="Projects">
      <div class="rail-stage">
        {projects.map((p, i) => (
          <button class="machine" data-i={i} aria-label={`Show ${p.short}`} aria-pressed={i === 0 ? "true" : "false"}>
            <img src={p.still} alt="" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
      <div class="rail-info">
        <button class="nav-btn" id="prev" aria-label="Previous build"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
        <div class="rail-text" aria-live="polite">
          {projects.map((p, i) => (
            <div class="rail-item" data-i={i} hidden={i !== 0}>
              <h3>{p.name}</h3>
              <p class="mono meta">{p.dates}{p.solo ? " · Solo build" : ""}</p>
              <p>{lines[p.slug]}</p>
              <a class="link-arrow" href={`/projects#${p.slug}`}>Read the build <Fragment set:html={arrow} /></a>
            </div>
          ))}
        </div>
        <button class="nav-btn" id="next" aria-label="Next build"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
      </div>
    </div>
  </section>

  <section class="about" id="about" aria-labelledby="about-h">
    <div class="about-inner">
      <img class="about-photo" src="/media/about/me-640.webp" alt="Maxwell Li" width="640" height="640" loading="lazy" />
      <div class="about-text">
        <h2 id="about-h">About me</h2>
        <!-- DRAFT for Maxwell to rewrite: built only from facts already on his site. -->
        <p>I'm Maxwell, a mechatronics engineering student at the University of Waterloo. I work on controls and embedded systems, and most of what I know I learned by building machines that move.</p>
        <p>That means VEX robots across two seasons, a quadcopter that finds and follows objects on its own, and a foam ground-effect vehicle I built to see how much power flying low really saves.</p>
        <p>Away from the workbench I travel, hike, game, and play instruments.</p>
        <blockquote class="quote">
          <p>"{quote}."</p>
          <footer class="mono">Maxwell Li</footer>
        </blockquote>
      </div>
    </div>

    <div class="card-row">
      {hobbies.map((h) => (
        <div class="folder-card" tabindex="0" role="button" aria-expanded="false" aria-label={`${h.title}: show photo`}>
          <div class="card-sheen" aria-hidden="true"></div>
          <div class="card-object">
            <img src={h.img} alt={h.alt} loading="lazy" decoding="async" />
            <div class="object-label">{h.title}</div>
          </div>
          <div class="card-face">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <mask id={`folder-mask-${h.title}`}>
                  <rect width="100" height="100" fill="white" />
                  <path d="M 20 0 L 20 11 Q 20 12 21 12 L 30 12 Q 31 12 31 11 L 31 0 Z" fill="black" />
                </mask>
              </defs>
              <rect width="100" height="100" fill="#10283b" mask={`url(#folder-mask-${h.title})`} />
            </svg>
            <div class="card-label">{h.title}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <script type="application/json" id="models-json" set:html={JSON.stringify({ beats: beats.map((b) => b.slug), models })} />
</Base>

<style>
  /* ---------- Story ---------- */
  .story { position: relative; height: 1050svh; background: var(--navy-900); }
  :global(html:not(.js)) .story, .story.static { height: auto; }
  .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .well-wrap { position: absolute; inset: 0; perspective: 900px; perspective-origin: 50% 30%; }
  .well { position: absolute; inset: 0; transform-origin: 50% 100%; will-change: transform, opacity; }
  .floor {
    position: absolute; left: 50%; bottom: -30svh; width: 120vw; height: 70svh; translate: -50% 0;
    background: radial-gradient(closest-side, rgba(215, 132, 70, 0.22), rgba(215, 132, 70, 0) 70%);
    opacity: 0; pointer-events: none;
  }
  .gl { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .stills { position: absolute; inset: 0; pointer-events: none; }
  .stills img { position: absolute; right: 6vw; top: 50%; width: min(56vw, 900px); translate: 0 -50%; opacity: 0; transition: opacity 400ms var(--ease-out); }
  .story.use-stills .gl { display: none; }
  .stills img.on { opacity: 1; }

  .words { position: absolute; inset: 0; pointer-events: none; }
  .word {
    position: absolute; left: 50%; top: 50%;
    font-size: clamp(5rem, 19vw, 20rem); font-weight: 800; font-stretch: 125%; letter-spacing: -0.03em; line-height: 0.9;
    text-transform: uppercase; white-space: nowrap;
    color: rgba(242, 244, 243, 0); -webkit-text-stroke: 1.5px rgba(157, 176, 191, 0.22);
    translate: -50% -50%; opacity: 0; will-change: transform, opacity;
  }
  .word.front { z-index: 2; }
  .gl { z-index: 1; }
  .chapter-marker { position: absolute; left: var(--margin); bottom: 30px; margin: 0; color: var(--muted); opacity: 0; z-index: 3; }

  .intro {
    position: absolute; inset: 0; z-index: 3; display: flex; flex-direction: column; justify-content: center;
    padding: calc(var(--nav-h) + 20px) var(--margin) 12svh; will-change: transform, opacity;
  }
  .intro h1 { font-size: clamp(3.6rem, 12.5vw, 12rem); font-stretch: 118%; font-weight: 800; letter-spacing: -0.035em; line-height: 0.92; }
  .intro .line { margin-top: 22px; max-width: 34ch; font-size: clamp(1.05rem, 1.6vw, 1.35rem); color: var(--muted); }
  .scale-bar { display: flex; width: min(360px, 70vw); height: 10px; margin-top: 30px; border-block: 1px solid var(--line); }
  .scale-bar span { flex: 1; border-right: 1px solid var(--line); }
  .scale-bar span:nth-child(odd) { background: var(--copper); opacity: 0.75; transform-origin: left; animation: fill 1.1s var(--ease) backwards; }
  .scale-bar span:nth-child(3) { animation-delay: 0.1s; } .scale-bar span:nth-child(5) { animation-delay: 0.2s; } .scale-bar span:nth-child(7) { animation-delay: 0.3s; }
  @keyframes fill { from { transform: scaleX(0); } }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 36px; }

  .beats { list-style: none; margin: 0; padding: 0; }
  .beat {
    position: absolute; left: var(--margin); top: 50%; width: min(420px, 36vw); translate: 0 -40%;
    opacity: 0; will-change: transform, opacity;
  }
  .beat { z-index: 3; }
  .beat.off { pointer-events: none; }
  .beat h2 { font-size: clamp(1.9rem, 3.4vw, 3.2rem); font-stretch: 108%; letter-spacing: -0.025em; line-height: 1.02; }
  .beat .text { margin-top: 16px; font-size: 1.08rem; color: #d3dde4; max-width: 38ch; }
  .beat .link-arrow { margin-top: 14px; }

  .stack {
    position: absolute; left: var(--margin); top: 50%; translate: 0 -50%;
    display: flex; flex-direction: column; font-size: clamp(3rem, 8.5vw, 8.5rem); font-weight: 800; font-stretch: 125%;
    letter-spacing: -0.03em; line-height: 0.9; text-transform: uppercase; pointer-events: none;
  }
  .stack span { color: rgba(242, 244, 243, 0); -webkit-text-stroke: 1.5px rgba(157, 176, 191, 0.35); opacity: 0; will-change: opacity, transform; transition: color 450ms var(--ease-out), -webkit-text-stroke-color 450ms var(--ease-out); }
  .stack span.lit { color: var(--ink); -webkit-text-stroke-color: rgba(242, 244, 243, 0); }
  .handoff { position: absolute; right: var(--margin); bottom: 14svh; text-align: right; font-size: clamp(1.3rem, 2.4vw, 2rem); font-weight: 600; font-stretch: 108%; line-height: 1.15; opacity: 0; }

  /* no JS or reduced motion: the story reads as a plain list */
  :global(html:not(.js)) .stage, .story.static .stage { position: relative; height: auto; overflow: visible; padding-bottom: 12vh; }
  :global(html:not(.js)) .intro, .story.static .intro { position: relative; min-height: 100svh; }
  :global(html:not(.js)) .beat, .story.static .beat { position: relative; left: auto; top: auto; translate: none; opacity: 1; visibility: visible; width: auto; max-width: 560px; margin: 0 var(--margin) 72px; }
  :global(html:not(.js)) .words, :global(html:not(.js)) .stack, :global(html:not(.js)) .handoff, :global(html:not(.js)) .gl,
  .story.static .words, .story.static .stack, .story.static .chapter-marker, .story.static .handoff, .story.static .gl, .story.static .stills,
  .story.static .floor, :global(html:not(.js)) .floor, .story.static .well-wrap { display: none; }
  .story.static .beat::before { content: ""; display: block; width: 100%; aspect-ratio: 16 / 9; margin-bottom: 20px; background: var(--still) center / contain no-repeat; }

  @media (max-width: 760px) {
    .beat { top: auto; bottom: calc(22px + env(safe-area-inset-bottom)); width: auto; right: var(--margin); translate: none; }
    .beat h2 { font-size: 1.75rem; }
    .beat .text { font-size: 1rem; }
    .chapter-marker { bottom: auto; top: calc(var(--nav-h) + 14px); }
    .word { top: 33%; font-size: 24vw; }
    .stack { top: 38%; font-size: 15vw; }
    .handoff { bottom: 12svh; }
    .stills img { right: 50%; translate: 50% -50%; top: 36%; width: 88vw; }
    .intro { justify-content: flex-end; padding-bottom: 16svh; }
  }

  /* ---------- The builds ---------- */
  .machines { position: relative; padding: clamp(96px, 14vh, 160px) var(--margin) clamp(80px, 12vh, 140px); background: var(--navy-900); overflow: hidden; }
  .machines-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 32px; align-items: end; max-width: 1320px; margin: 0 auto; }
  .machines-head h2 { font-size: clamp(2.6rem, 7vw, 6.5rem); font-stretch: 118%; letter-spacing: -0.035em; line-height: 0.92; }
  .machines-head p { color: var(--muted); font-size: 1.08rem; max-width: 52ch; }
  .rail { max-width: 1320px; margin: clamp(40px, 7vh, 80px) auto 0; }
  .rail-stage {
    position: relative; height: clamp(260px, 42vw, 520px);
    display: grid; grid-template-columns: repeat(4, 1fr); align-items: end; gap: 2vw;
    border-bottom: 1px solid var(--line);
    background: radial-gradient(ellipse 40% 60% at var(--lit, 12%) 100%, rgba(215, 132, 70, 0.2), transparent 70%);
    transition: background-position 600ms var(--ease);
  }
  .machine {
    appearance: none; border: 0; background: none; padding: 0 0 18px; cursor: pointer; height: 100%;
    display: flex; align-items: flex-end; justify-content: center;
    transform-origin: 50% 100%; transform: scale(0.72); opacity: 0.45; filter: saturate(0.5);
    transition: transform 700ms var(--ease), opacity 500ms var(--ease-out), filter 500ms var(--ease-out);
  }
  .machine img { width: 100%; max-height: 100%; object-fit: contain; object-position: 50% 100%; pointer-events: none; }
  .machine:hover { opacity: 0.75; }
  .machine[aria-pressed="true"] { transform: scale(1); opacity: 1; filter: none; }
  .rail-info { display: grid; grid-template-columns: 44px minmax(0, 1fr) 44px; gap: 24px; align-items: start; margin-top: 32px; }
  .nav-btn { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line); background: transparent; color: var(--ink); display: grid; place-items: center; cursor: pointer; transition: border-color 160ms var(--ease-out), transform 160ms var(--ease-out); }
  .nav-btn:hover { border-color: var(--copper); }
  .nav-btn:active { transform: scale(0.94); }
  .nav-btn svg { width: 20px; height: 20px; }
  .rail-item { max-width: 62ch; animation: itemIn 500ms var(--ease) both; }
  .rail-item .meta { margin-top: 10px; color: var(--copper-hi); }
  .rail-item h3 { font-size: clamp(1.6rem, 3vw, 2.4rem); font-stretch: 108%; letter-spacing: -0.02em; line-height: 1.05; }
  .rail-item p:not(.meta) { margin-top: 10px; color: #d3dde4; }
  @keyframes itemIn { from { opacity: 0; transform: translateY(8px); } }
  @media (max-width: 760px) {
    .machines-head { grid-template-columns: 1fr; }
    .rail-stage { grid-template-columns: repeat(4, 60vw); overflow-x: auto; scroll-snap-type: x mandatory; gap: 4vw; height: 64vw; padding-inline: 20vw; margin-inline: calc(-1 * var(--margin)); scrollbar-width: none; }
    .rail-stage::-webkit-scrollbar { display: none; }
    .machine { scroll-snap-align: center; }
    .rail-info { grid-template-columns: 44px minmax(0, 1fr) 44px; gap: 12px; }
  }

  /* ---------- About (paper) ---------- */
  .about { position: relative; background: var(--paper); color: var(--paper-ink); padding: clamp(96px, 14vh, 160px) var(--margin) clamp(80px, 12vh, 140px); }
  .about-inner { display: grid; grid-template-columns: minmax(200px, 320px) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); max-width: 1100px; margin: 0 auto; align-items: start; }
  .about-photo { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 6px; box-shadow: 0 18px 40px -18px rgba(40, 37, 34, 0.45); }
  .about-text h2 { font-size: clamp(2.4rem, 5vw, 4.2rem); font-stretch: 112%; letter-spacing: -0.03em; line-height: 0.95; margin-bottom: 26px; }
  .about-text p { max-width: 60ch; font-size: 1.12rem; line-height: 1.6; color: var(--paper-ink); }
  .about-text p + p { margin-top: 14px; }
  .quote { margin: 40px 0 0; padding: 26px 0 0; border-top: 1px solid rgba(40, 37, 34, 0.18); }
  .quote p { font-size: clamp(1.4rem, 2.6vw, 2.2rem); font-weight: 600; font-stretch: 106%; letter-spacing: -0.02em; line-height: 1.2; max-width: 30ch; color: var(--paper-ink); }
  .quote footer { margin-top: 14px; color: var(--paper-muted); }
  .about :focus-visible { outline-color: var(--navy-950); }
  @media (max-width: 700px) { .about-inner { grid-template-columns: 1fr; } .about-photo { width: 62%; } }

  /* Maxwell's folder cards, restyled into the palette (interaction unchanged) */
  .card-row { display: flex; justify-content: center; gap: clamp(14px, 2vw, 28px); max-width: 1320px; margin: clamp(72px, 11vh, 120px) auto 0; }
  .folder-card { position: relative; width: 240px; height: 300px; cursor: pointer; transition: transform 650ms var(--ease), opacity 600ms var(--ease), filter 600ms var(--ease); outline: none; border-radius: 12px; }
  .folder-card:focus-visible { outline: 2px solid var(--navy-950); outline-offset: 5px; }
  .card-sheen { position: absolute; inset: 0; border-radius: 12px; background: linear-gradient(150deg, var(--copper-hi), var(--copper) 55%, #a95f2c); }
  .card-object {
    position: absolute; top: 50%; left: 50%; width: 90%; height: 85%; 
    border-radius: 10px; box-shadow: 0 16px 34px -12px rgba(7, 23, 36, 0.55);
    transform: translate(-50%, 10%) rotate(-7deg); opacity: 0; transition: transform 700ms var(--ease), opacity 700ms var(--ease);
    display: flex; align-items: flex-end; justify-content: center; padding-bottom: 14px; overflow: hidden;
  }
  .card-object img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .object-label { position: relative; }
  .object-label { background: rgba(7, 23, 36, 0.78); color: var(--ink); padding: 6px 12px; border-radius: 6px; font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
  .card-face { position: absolute; inset: 0; border-radius: 12px; transition: transform 700ms var(--ease); display: flex; align-items: center; justify-content: center; filter: drop-shadow(0 10px 20px rgba(7, 23, 36, 0.28)); }
  .card-face svg { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 12px; }
  .card-label { position: relative; font-size: 1.15rem; font-weight: 700; font-stretch: 115%; color: var(--paper); letter-spacing: 0.04em; text-transform: uppercase; transition: opacity 550ms var(--ease); pointer-events: none; }
  .card-row:hover .folder-card, .card-row:focus-within .folder-card { transform: scale(0.94); opacity: 0.65; filter: saturate(0.6); }
  .folder-card:hover, .folder-card:focus-visible, .folder-card.open { transform: translateY(-6%) scale(1.06) !important; opacity: 1 !important; filter: none !important; z-index: 10; }
  .folder-card:hover .card-face, .folder-card:focus-visible .card-face, .folder-card.open .card-face { transform: translateY(90%); }
  .folder-card:hover .card-object, .folder-card:focus-visible .card-object, .folder-card.open .card-object { transform: translate(-50%, -54%) rotate(0deg); opacity: 1; }
  .folder-card:hover .card-label, .folder-card:focus-visible .card-label, .folder-card.open .card-label { opacity: 0; }
  @media (max-width: 1100px) { .card-row { flex-wrap: wrap; gap: 28px 18px; } .folder-card { width: 200px; height: 250px; } }
  @media (max-width: 480px) { .folder-card { width: calc(50% - 9px); height: 220px; } .card-label { font-size: 0.95rem; font-stretch: 100%; letter-spacing: 0.02em; } }
  @media (hover: none) { .card-row:hover .folder-card { transform: none; opacity: 1; filter: none; } }

  @media (prefers-reduced-motion: reduce) {
    .scale-bar span { animation: none; }
    .machine, .card-object, .card-face, .folder-card, .rail-item { transition-duration: 1ms; animation: none; }
  }
</style>

<script>
  import { initHome } from "../scripts/home";
  initHome();
</script>
