const quote = "— — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — What defines me are not my experiences, but rather the person I choose to become after walking through them — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — — —";

const hobbies = [
  { title: "Travelling", img: "/photos/about/travelling.jpeg" },
  { title: "Robotics", img: "/photos/about/robotics.jpeg" },
  { title: "Gaming", img: "/photos/about/gaming.jpeg" },
  { title: "Instruments", img: "/photos/about/instruments.jpg" },
  { title: "Hiking", img: "/photos/about/hiking.jpeg" },
];
---

<html lang="en">
  <head>
