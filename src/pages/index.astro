            </div>
          </div>
        </nav>
      </main>
    </div>

    <div class="marquee-band" id="marquee-band" aria-hidden="true">
      <div class="marquee-track" id="marquee-track">
        <span>{quote}</span>
      </div>
    </div>

    <section class="about">
      <div class="about-top">
        <div class="about-inner">
          <img class="about-photo" src="/photos/about/me.jpg" alt="Maxwell Li" />
          <div class="about-text">
            <h2>About Me</h2>
            <p>
              Hey, I'm Maxwell — a mechatronics engineering student at the University of Waterloo.
        
            </p>
            <p>
              I'm too lazy to finish this page rn,
            </p>
            <p>
              Cya later.
            </p>
          </div>
        </div>
      </div>

      <div class="hobby-grid">
        {hobbies.map((h) => (
          <div class="hobby-box">
            <div class="hobby-title">{h.title}</div>
            <img src={h.img} alt={h.title} />
          </div>
        ))}
      </div>
    </section>

    <style>
      :root {
        --navy: #0b1d2e;
        --grid: #16324a;
        --ink: #edf2f7;
        --muted: #7c93ac;
        --copper: #c9793c;
        --line: #2b4a66;
        --cream: #f5efe6;
        --cream-ink: #2b2420;
        --soft-blue: #3d6488;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: var(--navy); }
      body { font-family: "IBM Plex Mono", monospace; color: var(--ink); }

      .sheet {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background-image:
          linear-gradient(var(--grid) 1px, transparent 1px),
          linear-gradient(90deg, var(--grid) 1px, transparent 1px);
        background-size: 40px 40px;
      }

      .reg { position: absolute; width: 18px; height: 18px; opacity: 0.6; }
      .reg::before, .reg::after { content: ""; position: absolute; background: var(--muted); }
      .reg::before { width: 100%; height: 1px; top: 50%; }
      .reg::after { height: 100%; width: 1px; left: 50%; }
      .reg-tl { top: 24px; left: 24px; }
      .reg-tr { top: 24px; right: 24px; }
      .reg-bl { bottom: 24px; left: 24px; }
      .reg-br { bottom: 24px; right: 24px; }

      main {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem;
      }

      h1 {
        font-family: "Space Grotesk", sans-serif;
        font-weight: 700;
        font-size: clamp(2.75rem, 8vw, 5.5rem);
        letter-spacing: 0.01em;
        margin: 0;
        color: var(--ink);
      }

      .tagline {
        margin: 0.75rem 0 2rem;
        color: var(--muted);
        font-size: clamp(0.85rem, 1.6vw, 1.05rem);
        letter-spacing: 0.01em;
      }

      .scale-bar {
        display: flex;
        width: min(360px, 70vw);
        height: 10px;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        overflow: hidden;
      }
      .scale-bar span { flex: 1; border-right: 1px solid var(--line); }
      .scale-bar span:nth-child(odd) {
        background: var(--copper);
        opacity: 0.7;
        animation: fill 1.1s ease-out backwards;
      }
      .scale-bar span:nth-child(1) { animation-delay: 0.05s; }
      .scale-bar span:nth-child(3) { animation-delay: 0.15s; }
      .scale-bar span:nth-child(5) { animation-delay: 0.25s; }
      .scale-bar span:nth-child(7) { animation-delay: 0.35s; }
      @keyframes fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }

      .actions {
        margin-top: 2.5rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
      }

      .btn {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.65rem 1.3rem;
        border-radius: 999px;
        background: rgba(43, 74, 102, 0.35);
        border: 1px solid var(--line);
        color: var(--ink);
        text-decoration: none;
        font-size: 0.85rem;
        letter-spacing: 0.01em;
        font-family: "IBM Plex Mono", monospace;
        cursor: pointer;
        transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
      }

      .btn svg { width: 16px; height: 16px; color: var(--copper); flex-shrink: 0; }

      .btn:hover {
        transform: translateY(-3px) scale(1.04);
        background: rgba(43, 74, 102, 0.65);
        border-color: var(--copper);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
      }

      .btn:focus-visible { outline: 2px solid var(--copper); outline-offset: 2px; }

      .dropdown { position: relative; }

      .menu {
        position: absolute;
        top: calc(100% + 0.5rem);
        left: 50%;
        transform: translateX(-50%) translateY(-4px);
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-width: 180px;
        padding: 0.5rem;
        background: #0f2438;
        border: 1px solid var(--line);
        border-radius: 14px;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
        z-index: 10;
      }

      .menu.open { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }

      .menu-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.55rem 0.75rem;
        border-radius: 8px;
        color: var(--ink);
        text-decoration: none;
        font-size: 0.85rem;
        transition: transform 0.15s ease, background 0.15s ease;
      }

      .menu-item svg { width: 15px; height: 15px; color: var(--copper); flex-shrink: 0; }

      .menu-item:hover { transform: translateX(4px) scale(1.03); background: rgba(201, 121, 60, 0.12); }

      .marquee-band {
        position: relative;
        height: 48px;
        overflow: hidden;
        background: var(--navy);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }
      .marquee-track {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        white-space: nowrap;
        will-change: transform;
      }
      .marquee-track span {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        color: var(--copper);
      }

      .about {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--cream);
      }
      .about-top {
        flex: 1;
        display: flex;
        align-items: center;
        padding: 2.5rem clamp(1.5rem, 5vw, 4rem);
      }
      .about-inner {
        max-width: 900px;
        margin: 0 auto;
        display: flex;
        align-items: flex-start;
        gap: 2.5rem;
        flex-wrap: wrap;
      }
      .about-photo {
        width: 240px;
        height: 240px;
        object-fit: cover;
        border-radius: 14px;
        flex-shrink: 0;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
      }
      .about-text { flex: 1; min-width: 280px; }
      .about-text h2 {
        font-family: "Fraunces", serif;
        font-weight: 600;
        font-size: clamp(1.75rem, 3vw, 2.25rem);
        color: var(--cream-ink);
        margin: 0 0 1rem;
      }
      .about-text p {
        font-family: "Inter", sans-serif;
        line-height: 1.75;
        font-size: 0.92rem;
        color: var(--cream-ink);
        margin: 0 0 1.1rem;
      }

      .hobby-grid {
        display: flex;
        gap: 1.25rem;
        height: clamp(220px, 28vh, 340px);
        padding: 0 clamp(1.5rem, 5vw, 4rem) clamp(1.5rem, 5vw, 3rem);
      }
      .hobby-box {
        flex: 1;
        display: flex;
        flex-direction: column;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.15);
      }
      .hobby-title {
        background: var(--soft-blue);
        color: var(--cream);
        font-family: "Space Grotesk", sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        text-align: center;
        padding: 0.5rem 0.25rem;
      }
      .hobby-box img { flex: 1; width: 100%; object-fit: cover; display: block; min-height: 0; }

      @media (max-width: 720px) {
        .hobby-grid { flex-wrap: wrap; height: auto; }
        .hobby-box { flex: 1 1 calc(50% - 0.625rem); }
        .hobby-box img { aspect-ratio: 1 / 1; }
      }
      @media (max-width: 620px) {
        .about-inner { flex-direction: column; text-align: center; }
        .about-photo { width: 200px; height: 200px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .scale-bar span { animation: none !important; transform: none !important; }
        .btn { transition: none; }
        .btn:hover { transform: none; }
      }
    </style>

    <script>
      const btn = document.getElementById("contact-btn");
      const menu = document.getElementById("contact-menu");

      btn?.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = menu?.classList.toggle("open");
        btn.setAttribute("aria-expanded", String(!!isOpen));
      });

      document.addEventListener("click", (e) => {
        if (!menu?.classList.contains("open")) return;
        const target = e.target as Node;
        if (!menu.contains(target) && !btn?.contains(target)) {
          menu.classList.remove("open");
          btn?.setAttribute("aria-expanded", "false");
        }
      });

      const band = document.getElementById("marquee-band") as HTMLElement;
      const track = document.getElementById("marquee-track") as HTMLElement;
      let referenceScroll = 0;

      function measure() {
        if (!band) return;
        const rect = band.getBoundingClientRect();
        const bandCenterDocY = rect.top + window.scrollY + rect.height / 2;
        referenceScroll = bandCenterDocY - window.innerHeight / 2;
      }

      function updateMarquee() {
        if (!track) return;
        const delta = window.scrollY - referenceScroll;
        track.style.transform = `translate(calc(-50% - ${delta * 0.5}px), -50%)`;
      }

      measure();
      updateMarquee();
      window.addEventListener("resize", () => {
        measure();
        updateMarquee();
      });
      window.addEventListener("scroll", updateMarquee, { passive: true });
    </script>
  </body>
</html>