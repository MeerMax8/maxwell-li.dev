    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&family=Fraunces:wght@500;600&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="sheet">
      <span class="reg reg-tl"></span>
      <span class="reg reg-tr"></span>
      <span class="reg reg-bl"></span>
      <span class="reg reg-br"></span>

      <main>
        <h1>Maxwell Li</h1>
        <p class="tagline">mechatronics engineering — controls &amp; embedded systems</p>
        <div class="scale-bar" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        </div>

        <nav class="actions">
          <a class="btn" href={links[0].url} target="_blank" rel="noopener noreferrer">
